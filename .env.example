# Copy this file to .env and fill in your Firebase web app config.
# Find these in Firebase Console: Project settings -> General -> Your apps -> Web app -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Used only by `npm run seed` (a local Node script, not the deployed app).
# Same values as above, without the VITE_ prefix.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional — powers the "Ask OrgSynq" chat assistant, Prediction, Placement,
# Learning career-path suggestions, and the 1:1 assistant (Google Gemini).
# Get a free key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Optional — additional Gemini API keys (ideally from separate Google
# accounts/projects, so they have independent quotas) for automatic
# failover. If a call hits Google's "server overloaded" (503) or a quota
# limit (429) on one key, or a specific key is rejected outright (e.g.
# the "AQ." key auth issue — see README troubleshooting), the app
# immediately tries the next configured key instead of failing. Not
# required — VITE_GEMINI_API_KEY alone works fine, this just adds
# resilience. Add as many as you have, in order (_2 through _5).
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=

# Required by `npm run seed` only. Firestore rules require a signed-in
# user for every write, so the seed script logs in with this account
# before writing sample data. Sign up for this account in the app first
# (or add it in Firebase Console -> Authentication -> Add user).
SEED_EMAIL=
SEED_PASSWORD=
