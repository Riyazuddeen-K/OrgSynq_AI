# Copy this file to .env and fill in your Firebase web app config.
# Find these in Firebase Console: Project settings -> General -> Your apps -> Web app -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Used only by `npm run seed` (a local Node script, not the deployed app).
# Same values as above, without the VITE_ prefix.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional — powers the "Ask OrgSynq" chat assistant, team formation
# (Prediction), and Placement matching (all Google Gemini).
# Get a free key at https://aistudio.google.com/app/apikey
#
# Single key:
VITE_GEMINI_API_KEY=
#
# Multiple keys for automatic failover (recommended for production): put
# them ALL in VITE_GEMINI_API_KEYS instead, comma-separated, no spaces
# needed around the commas. If a key hits a quota/overload error (429/503)
# or is rejected as invalid (401), the app automatically rotates to the
# next key in the list before falling back to a local deterministic
# response — no restart or redeploy needed. Leave VITE_GEMINI_API_KEY
# blank if you set this instead (or set both; VITE_GEMINI_API_KEYS wins).
# VITE_GEMINI_API_KEYS=AIzaSy-key-one,AIzaSy-key-two,AIzaSy-key-three

# Required by `npm run seed` only. Firestore rules require a signed-in
# user for every write, so the seed script logs in with this account
# before writing sample data. Sign up for this account in the app first
# (or add it in Firebase Console -> Authentication -> Add user).
SEED_EMAIL=
SEED_PASSWORD=
