# Copy this file to .env and fill in your Firebase web app config.
# Find these in Firebase Console: Project settings -> General -> Your apps -> Web app -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Used only by `npm run seed` (a local Node script, not the deployed app).
# Same values as above, without the VITE_ prefix.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional — powers the "Ask OrgSynq" chat assistant (Google Gemini).
# Get a free key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
