rules_version = '2';

// =========================================================
// OrgSynq AI — Firestore security rules
// Paste this into Firebase Console -> Firestore Database -> Rules
//
// Model: any signed-in user (email/password, created via the
// Login/Sign-up screen) can read and write workforce data. This
// matches the app's current "single workspace, all authenticated
// staff are admins" model. The `users` collection stores each
// person's profile/role and is scoped to their own document.
//
// To go further (e.g. read-only "employee" role vs "admin" role),
// add a `role` check that reads the caller's own users/{uid} doc,
// e.g.:
//   function isAdmin() {
//     return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
//   }
// and use `allow write: if isAdmin();` on the collections you want
// to lock down further.
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Each user can only read/write their own profile document.
    // AuthContext auto-creates this on first sign-in.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // All other workspace data: any signed-in user can read and write.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
